NODE_ENV=development
PORT=4000
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/doctor-tracker
# MongoDB Atlas (replace credentials and cluster):
# MONGODB_URI=mongodb+srv://<db-user>:<password>@<cluster>.mongodb.net/doctor-tracker?retryWrites=true&w=majority&appName=doctor-tracker

# Browser origin of the Next.js app. Used by CORS and the state-changing request origin check.
CLIENT_ORIGIN=http://localhost:3000

SESSION_TTL_DAYS=7
# Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# Number of reverse proxies in front of this API (Next.js rewrites count as one).
# Needed so rate limiting sees the real client IP.
TRUST_PROXY=1

# Optional: password for the demo admin created by `npm run seed`.
# SEED_ADMIN_PASSWORD=
